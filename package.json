{
  "name": "tripact",
  "version": "0.0.1",
  "description": "The deterministic traceability kernel — keep spec, docs, and tests describing the same behaviour. A three-way pact any harness can drive.",
  "type": "module",
  "license": "MIT",
  "author": "Leo Coleman <leo.coleman@gscan.eu>",
  "keywords": [
    "traceability",
    "spec-driven-development",
    "requirements",
    "testing",
    "agents",
    "deterministic",
    "drift"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tripact": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^13.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
